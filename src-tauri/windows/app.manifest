<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Windows application manifest for Universal MCP Manager.

  Every binary built from this package embeds this exact manifest: the app
  binary and each test harness (unit tests and the integration tests in
  `tests/`). `build.rs` hands it to the MSVC linker with `/MANIFEST:EMBED`
  and `/MANIFESTINPUT:` while `tauri-build` is configured to not embed its
  own copy, so the resource is never duplicated (CVT1100).

  Why it matters for tests: `cargo test` links the full GUI stack, and
  `tao`/`rfd`/`muda` import `TaskDialogIndirect`. That symbol only exists in
  Common Controls v6; without the dependency below the loader binds the
  legacy comctl32 v5.82 and every test binary aborts at startup with
  STATUS_ENTRYPOINT_NOT_FOUND (0xC0000139).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Common Controls v6: required for TaskDialogIndirect (rfd/muda/tao) and
       modern themed widgets. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <!-- Declare the OS versions this application supports so version APIs report
       the real Windows version instead of a compatibility-shimmed one. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>

  <!-- Config files can live at deep paths on Windows; opt in to long paths.
       Note: DPI awareness is intentionally absent - Tauri sets it at runtime
       (SetProcessDpiAwarenessContext) and a manifest value would win over it. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
